# Example secrets file. Copy it, fill in real values, and encrypt with SOPS+age:
#
#   cp secrets.example.env secrets.env      # fill in values, then:
#   sops --encrypt --age <your-age-recipient> secrets.env > secrets.enc.env
#   rm secrets.env                          # never keep plaintext around
#
# Run james with the secrets decrypted into the environment for one command:
#
#   sops exec-env secrets.enc.env 'flox activate -- ./james serve'
#
# NEVER commit a plaintext secrets file. Only this .example is tracked.

# Messaging bot tokens — only needed for the channels you enable in config.yaml.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# API key for the `gpt` (api) backend; works with any OpenAI-compatible provider.
OPENAI_API_KEY=

# Password for the optional web dashboard (config.yaml web.token_env). Only
# needed when web.enabled=true; empty disables the dashboard (fail-closed).
JAMES_WEB_PASSWORD=

# Bearer token(s) for A2A peer backends (the remote agent's shared secret, sent
# only to that peer). An unset token disables that a2a backend (fail-closed).
# OPENCLAW_A2A_TOKEN: the openclaw-a2a-gateway inbound bearer.
OPENCLAW_A2A_TOKEN=
# HERMES_A2A_TOKEN: leave unset — hermes has no A2A endpoint yet (placeholder).
HERMES_A2A_TOKEN=

# The cli backends (claude, codex, grok, opencode) use their own CLI logins —
# run each tool's one-time login once on the host; no keys belong here.

# Secrets the AGENT may need to USE (e.g. a database). These are injected into
# james's environment and inherited by the agent process, so the agent can use
# them via a tool that reads the env var — they are NEVER put in the prompt, so
# the model/provider never sees them. IMPORTANT: scope to least privilege (a
# read-only role / short-lived token), not a master password — see README →
# "Secrets the agents can use" for stronger isolation (a broker / HTTP MCP).
# DATABASE_URL=postgres://readonly:...@host:5432/db
